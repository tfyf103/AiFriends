# AiFriends 后端环境变量示例
# 复制本文件为 .env 后再填写真实值：
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
#
# ⚠️ 不要把真实 API Key 提交到 GitHub。

# OpenAI-compatible API Key。
# 当前代码中的 ChatOpenAI、OpenAI Embeddings、ASR/TTS 都会读取这个变量。
API_KEY=your_api_key_here

# OpenAI-compatible HTTP API Base。
# 例如你所使用的大模型服务商提供的兼容接口地址。
API_BASE=https://your-openai-compatible-endpoint/v1

# 语音服务 WebSocket 地址。
# backend/web/views/friend/message/asr/asr.py 与
# backend/web/views/friend/message/chat/chat.py 会读取它。
WSS_URL=wss://your-speech-service-websocket-endpoint
