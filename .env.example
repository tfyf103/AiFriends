# AiFriends 环境变量示例
# 复制本文件为 .env 后再填写真实值：
#   Windows PowerShell: Copy-Item .env.example .env
#   macOS / Linux:      cp .env.example .env
#
# ⚠️ 不要把真实 API Key / Django Secret 提交到 GitHub。

# -----------------------------------------------------------------------------
# 0. Django（本地学习保持默认即可）
# -----------------------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=development-only-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_PATH=./db.sqlite3
# MEDIA_ROOT=./media
# MEDIA_URL=/media/

# -----------------------------------------------------------------------------
# 1. 第一次学习推荐：mock
# -----------------------------------------------------------------------------
# mock：完全不调用外部模型，零 API Key 也能学习 Vue/Django/JWT/SSE。
# text：只调用真实聊天模型，默认关闭 RAG / ASR / TTS。
# full：兼容旧项目行为，默认开启 Chat / RAG / ASR / TTS。
AI_MODE=mock

# 可以覆盖模式默认值。新手建议先全部关闭，再逐项打开。
ENABLE_RAG=false
ENABLE_ASR=false
ENABLE_TTS=false

# -----------------------------------------------------------------------------
# 2. OpenAI-compatible HTTP API
# -----------------------------------------------------------------------------
# mock 模式可以保持占位符；text/full 模式需要填写真实值。
API_KEY=your_api_key_here
API_BASE=https://your-openai-compatible-endpoint/v1

# 模型名全部配置化，避免为了换供应商去改 Python 源码。
CHAT_MODEL=deepseek-v4-pro
MEMORY_MODEL=deepseek-v4-pro
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# -----------------------------------------------------------------------------
# 3. Speech WebSocket（仅 ENABLE_ASR / ENABLE_TTS=true 时需要）
# -----------------------------------------------------------------------------
WSS_URL=wss://your-speech-service-websocket-endpoint
ASR_MODEL=gummy-realtime-v1
TTS_MODEL=cosyvoice-v3-flash
